# Copy to .env and set DATABASE_URL before running migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=4001
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN="7d"
GEMINI_API_KEY="your-gemini-api-key"

# Frontend and Backend URLs
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:4001"

# Google OAuth (Redirect URI: https://codevault-2.vercel.app/api/auth/google/callback)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth (Callback URL: https://codevault-2.vercel.app/api/auth/github/callback)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"